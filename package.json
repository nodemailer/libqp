{
    "name": "libqp",
    "version": "3.0.1",
    "description": "Encode and decode quoted-printable strings according to rfc2045",
    "type": "module",
    "main": "./dist/cjs/libqp.js",
    "types": "./dist/cjs/libqp.d.ts",
    "typesVersions": {
        "*": {
            "lib/*": [
                "dist/cjs/*.d.ts"
            ]
        }
    },
    "exports": {
        ".": {
            "import": "./dist/esm/libqp.js",
            "require": "./dist/cjs/libqp.js"
        },
        "./lib/libqp.js": {
            "import": "./dist/esm/libqp.js",
            "require": "./dist/cjs/libqp.js"
        },
        "./lib/libqp": {
            "import": "./dist/esm/libqp.js",
            "require": "./dist/cjs/libqp.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "lib",
        "CHANGELOG.md",
        "SECURITY.md"
    ],
    "scripts": {
        "build": "node scripts/build.js",
        "typecheck": "tsc -p tsconfig.json",
        "pretest": "npm run build",
        "test": "node --import tsx --test $(find test -name '*-test.ts')",
        "pretest:coverage": "npm run build",
        "test:coverage": "c8 node --import tsx --test $(find test -name '*-test.ts')",
        "pretest:bun": "npm run build",
        "test:bun": "bun test --timeout 60000 $(find ./test -name '*-test.ts')",
        "format": "prettier --write \"**/*.{js,cjs,ts,json,md,yml,yaml}\"",
        "format:check": "prettier --check \"**/*.{js,cjs,ts,json,md,yml,yaml}\"",
        "lint": "npm run typecheck && eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "npm run build",
        "update": "rm -rf node_modules package-lock.json && ncu -u && npm install",
        "test:mutation": "node scripts/mutation-test.js",
        "test:fuzz": "FUZZ_ITERATIONS=${FUZZ_ITERATIONS:-20000} FUZZ_SEED=${FUZZ_SEED:-random} node --import tsx --test test/property-test.ts test/legacy-test.ts"
    },
    "repository": {
        "type": "git",
        "url": "git://github.com/nodemailer/libqp.git"
    },
    "keywords": [
        "quoted-printable",
        "mime"
    ],
    "author": "Andris Reinman",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/nodemailer/libqp/issues"
    },
    "homepage": "https://github.com/nodemailer/libqp",
    "devDependencies": {
        "@types/node": "20.19.43",
        "c8": "12.0.0",
        "eslint": "10.13.0",
        "eslint-config-prettier": "10.1.8",
        "fast-check": "4.10.2",
        "globals": "17.13.0",
        "libqp-legacy": "npm:libqp@2.1.3",
        "prettier": "3.9.10",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.71.2"
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
